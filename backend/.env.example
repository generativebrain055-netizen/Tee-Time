# ============================================================================
# TeeTime Social Backend - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================================

# ============================================================================
# Server Configuration
# ============================================================================
NODE_ENV=development
PORT=3000

# SSL/HTTPS Configuration (for production/AWS deployment)
# Leave empty for HTTP-only (development)
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=

# ============================================================================
# Database - Supabase Configuration
# Note: For profile photo uploads, create an "avatars" bucket in Supabase Storage
# (Dashboard → Storage → New bucket) or it will be auto-created on startup.
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================================
# JWT Configuration
# Generate a secure random string for JWT_SECRET
# ============================================================================
JWT_SECRET=your_secure_random_string_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Twilio - SMS/OTP & Magic Link Configuration
# Get these from: https://console.twilio.com/
# NOTE: TWILIO_ACCOUNT_SID must start with AC (not SK). TWILIO_FROM_NUMBER must be a Twilio number.
# Without Twilio configured, SMS magic links are logged in development only.
# ============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Optional: Twilio Verify Service (recommended for production)
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Magic Link (SMS & email) - API URL for web fallback links in SMS
API_URL=https://api.teetimesocial.app
MAGIC_LINK_EXPIRY_MINUTES=15

# OTP Configuration
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# ============================================================================
# SendGrid - Email Configuration
# Get API key from: https://app.sendgrid.com/settings/api_keys
# ============================================================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# Google OAuth & Firebase Configuration
# Get these from:
# - Firebase Console: https://console.firebase.google.com/
# - Google Cloud Console: https://console.cloud.google.com/apis/credentials
# ============================================================================

# Firebase Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Google OAuth Client IDs (from Google Cloud Console)
GOOGLE_CLIENT_ID_IOS=your_ios_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# Apple Sign In Configuration
# Get these from: https://developer.apple.com/account/resources/identifiers/list
# ============================================================================
APPLE_CLIENT_ID=com.teetimesocial.app
APPLE_SERVICE_ID=com.teetimesocial.app.signin
APPLE_TEAM_ID=your_team_id
APPLE_KEY_ID=your_key_id
APPLE_PRIVATE_KEY_PATH=../config/keys/AuthKey_YourKeyID.p8

# ============================================================================
# CORS Configuration
# Add your frontend URLs here (comma-separated)
# ============================================================================
ALLOWED_ORIGINS=https://api.teetimesocial.app

# ============================================================================
# NOTES:
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. Keep your secrets secure and rotate them regularly
# 3. Use different credentials for development and production
# 4. For production, use environment variables from your hosting provider
# ============================================================================
