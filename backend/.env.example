# ============================================================================
# Server Configuration
# ============================================================================
NODE_ENV=development
PORT=3000

# ============================================================================
# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================================================
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================================
# JWT Configuration
# Generate a secure random string (min 32 characters)
# ============================================================================
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# Twilio (SMS/OTP)
# Get these from: https://console.twilio.com/
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid  # Optional
TWILIO_FROM_NUMBER=

# OTP Configuration
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# ============================================================================
# SendGrid (Email)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# ============================================================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# Google OAuth
# Get these from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client IDs for iOS, Android, and Web
# ============================================================================
GOOGLE_CLIENT_ID_IOS=your_ios_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com

# ============================================================================
# Apple Sign In
# Get these from: https://developer.apple.com/account/resources/identifiers/list
# ============================================================================
APPLE_CLIENT_ID=com.yourapp.bundle
APPLE_SERVICE_ID=com.yourapp.bundle.signin
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY_PATH=config/keys/AuthKey_XXXXX.p8

# ============================================================================
# CORS Configuration
# Comma-separated list of allowed origins
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006
