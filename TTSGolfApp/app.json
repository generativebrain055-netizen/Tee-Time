{
  "expo": {
    "name": "Tee Time",
    "slug": "TTSGolfApp",
    "scheme": "teetimesocial",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/AppIcon.png",
      "bundleIdentifier": "com.teetimesocial.app",
      "buildNumber": "8",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes and take profile photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select profile photos.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to find nearby golf courses.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "CFBundleDisplayName": "Tee Time"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/AppIcon.png",
      "edgeToEdgeEnabled": true,
      "package": "com.teetimesocial.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-apple-authentication",
      "expo-location",
      [
        "expo-camera",
        {
          "cameraPermission": "This app uses the camera to scan QR codes and take profile photos."
        }
      ],
      "./plugins/withIosNoEmptyDsym.js",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.313307134076-0u8uc1o1hsas4l2amdvj8k4q1cc7b5qt"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f694ef1-a1bb-4fda-bc59-05760bcbe22c"
      }
    }
  }
}