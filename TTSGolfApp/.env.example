# ============================================================================
# Mobile App Environment Variables
# All variables MUST be prefixed with EXPO_PUBLIC_ to be accessible in the app
# ============================================================================

# Backend API URL
# For local development, use your computer's local network IP (not localhost)
# Find your IP: 
#   - Windows: Run 'ipconfig' in terminal, look for IPv4 Address
#   - Mac/Linux: Run 'ifconfig' in terminal, look for inet address
# Example: http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000

# Google OAuth Client IDs
# Get these from: https://console.cloud.google.com/apis/credentials
# You need both iOS and Web client IDs for Expo to work properly
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com

# Apple Sign In
# Bundle ID from your Apple Developer account
# Get from: https://developer.apple.com/account/resources/identifiers/list
EXPO_PUBLIC_APPLE_CLIENT_ID=com.yourapp.bundle
