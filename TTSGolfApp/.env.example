# ============================================================================
# TeeTime Social Mobile App - Environment Configuration
# Copy this file to .env and fill in your actual values
# All variables MUST be prefixed with EXPO_PUBLIC_ to be accessible in the app
# ============================================================================

# ============================================================================
# Backend API Configuration
# ============================================================================
# For development: Use your local machine's IP address (not localhost)
# Find your IP: Windows (ipconfig), Mac/Linux (ifconfig)
# Example: http://192.168.1.100:3000
EXPO_PUBLIC_API_URL=http://YOUR_LOCAL_IP:3000

# ============================================================================
# Firebase Configuration
# Get these from: Firebase Console → Project Settings → General
# https://console.firebase.google.com/project/_/settings/general
# ============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_app_id:platform:app_hash

# ============================================================================
# Google OAuth Configuration
# Get this from: Google Cloud Console → Credentials
# Use the Web Client ID (not Android or iOS)
# https://console.cloud.google.com/apis/credentials
# ============================================================================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# ============================================================================
# NOTES:
# ============================================================================
# 1. Never commit the actual .env file to version control
# 2. For production builds, update EXPO_PUBLIC_API_URL to your production API
# 3. Restart Expo dev server after changing environment variables
# 4. Use 'npx expo start -c' to clear cache if changes don't take effect
# ============================================================================
