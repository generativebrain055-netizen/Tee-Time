{
    "cli": {
        "version": ">= 5.2.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "ios": {
                "simulator": true
            },
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "ios": {
                "simulator": false
            }
        },
        "production": {
            "ios": {
                "simulator": false
            },
            "android": {
                "buildType": "app-bundle"
            }
        },
        "internal-testing": {
            "distribution": "internal",
            "ios": {
                "simulator": false,
                "buildConfiguration": "Release",
                "enterpriseProvisioning": "adhoc"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "kevin@caspianbridge.com",
                "ascAppId": "6757623508",
                "appleTeamId": "P2DD49N89K"
            },
            "android": {
                "serviceAccountKeyPath": "../google-play-service-account.json",
                "track": "internal"
            }
        }
    }
}