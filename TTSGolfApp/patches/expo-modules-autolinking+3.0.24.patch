+package expo.modules.plugin
+
+import java.io.File
+import java.util.Properties
+
+/**
+ * Resolves the Node.js binary when `node` is not on PATH (common when Gradle is started from Android Studio).
+ * Order: NODE_BINARY, local.properties `node.executable`, Homebrew paths, login-shell `command -v node`, then `node`.
+ */
+object NodeExecutable {
+  @Volatile
+  private var loginShellNode: String? = null
+
+  fun path(androidRootOrNull: File? = null): String {
+    System.getenv("NODE_BINARY")?.trim()?.takeIf { it.isNotEmpty() }?.let {
+      if (File(it).exists()) return it
+    }
+    androidRootOrNull?.let { root ->
+      val lp = File(root, "local.properties")
+      if (lp.exists()) {
+        try {
+          val p = Properties()
+          lp.inputStream().use { stream -> p.load(stream) }
+          p.getProperty("node.executable")?.trim()?.takeIf { it.isNotEmpty() }?.let {
+            if (File(it).exists()) return it
+          }
+        } catch (_: Exception) {
+        }
+      }
+    }
+    listOf("/opt/homebrew/bin/node", "/usr/local/bin/node").forEach {
+      if (File(it).exists()) return it
+    }
+    resolveViaLoginShell()?.let { return it }
+    if (Os.isWindows()) {
+      resolveWhereNode()?.let { return it }
+    }
+    return "node"
+  }
+
+  private fun shellLookupCommands(): List<List<String>> =
+    when {
+      Os.isWindows() -> emptyList()
+      isMacOs() -> listOf(
+        listOf("/bin/zsh", "-lic", "command -v node"),
+        listOf("/bin/bash", "-lc", "command -v node"),
+      )
+      else -> listOf(listOf("/bin/bash", "-lc", "command -v node"))
+    }
+
+  private fun resolveViaLoginShell(): String? {
+    val commands = shellLookupCommands()
+    if (commands.isEmpty()) return null
+    loginShellNode?.let { return it }
+    synchronized(NodeExecutable::class.java) {
+      loginShellNode?.let { return it }
+      for (cmd in commands) {
+        try {
+          val proc = ProcessBuilder(cmd)
+            .redirectErrorStream(true)
+            .start()
+          val out = proc.inputStream.bufferedReader().use { it.readText() }.trim()
+          if (proc.waitFor() != 0 || out.isEmpty()) continue
+          val first = out.lineSequence().map { it.trim() }.firstOrNull { it.isNotEmpty() } ?: continue
+          if (File(first).exists()) {
+            loginShellNode = first
+            return first
+          }
+        } catch (_: Exception) {
+        }
+      }
+      return null
+    }
+  }
+
+  private fun resolveWhereNode(): String? {
+    try {
+      val proc = ProcessBuilder("cmd.exe", "/c", "where.exe node")
+        .redirectErrorStream(true)
+        .start()
+      val out = proc.inputStream.bufferedReader().use { it.readText() }.trim()
+      if (proc.waitFor() != 0 || out.isEmpty()) return null
+      val first = out.lineSequence().map { it.trim() }.firstOrNull { it.isNotEmpty() } ?: return null
+      return if (File(first).exists()) first else null
+    } catch (_: Exception) {
+      return null
+    }
+  }
+
+  private fun isMacOs(): Boolean =
+    System.getProperty("os.name")?.lowercase()?.contains("mac") == true
+}
